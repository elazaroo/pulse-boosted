{
    "name": "elazaroo/pulse-boosted",
    "description": "Laravel Pulse with native SQL Server support and deep queue and job observability.",
    "keywords": [
        "laravel"
    ],
    "homepage": "https://github.com/elazaroo/pulse-boosted",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/elazaroo/pulse-boosted/issues",
        "source": "https://github.com/elazaroo/pulse-boosted"
    },
    "authors": [
        {
            "name": "Eneko Lazaro",
            "email": "enekolazaroalba@gmail.com"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original author of laravel/pulse"
        }
    ],
    "require": {
        "php": "^8.1",
        "doctrine/sql-formatter": "^1.4.1",
        "guzzlehttp/promises": "^1.0|^2.0|^3.0",
        "illuminate/auth": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/cache": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/config": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/console": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/contracts": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/database": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/events": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/http": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/queue": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/redis": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/routing": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/support": "^10.48.4|^11.0.8|^12.0|^13.0",
        "illuminate/view": "^10.48.4|^11.0.8|^12.0|^13.0",
        "laravel/sentinel": "^1.0",
        "league/uri": "^7.5.1",
        "livewire/livewire": "^3.6.4|^4.0",
        "nesbot/carbon": "^2.67|^3.0",
        "symfony/console": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.7|^8.0",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^8.36|^9.15|^10.8|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.2|^3.0|^4.0",
        "phpstan/phpstan": "^2.1.33",
        "predis/predis": "^1.0|^2.0"
    },
    "conflict": {
        "nunomaduro/collision": "<7.7.0"
    },
    "autoload": {
        "psr-4": {
            "Elazaroo\\PulseBoosted\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Elazaroo\\PulseBoosted\\PulseServiceProvider"
            ],
            "aliases": {
                "PulseBoosted": "Elazaroo\\PulseBoosted\\Facades\\Pulse"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": "@prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/pest"
        ]
    }
}
